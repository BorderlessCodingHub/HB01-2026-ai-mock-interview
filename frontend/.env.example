# frontend (Next.js) - copy to frontend/.env.local for local development.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_BORDERLESS_SIGNUP_URL=https://platform.borderlesscoding.com/sign-up

# better-auth (server-only)
BETTER_AUTH_SECRET=your-super-secret-better-auth-key-min-32-chars
# Public origin of this Next app (no path). Local: http://localhost:3001
# Production: https://labs.borderlesscoding.com
# Do not include /ai-mock-interview — Next.js basePath is applied separately.
BETTER_AUTH_URL=http://localhost:3001
BORDERLESS_API_BASE=https://api.borderlesscoding.com

# Express base for server-to-server opaque-token registration (same host as NEXT_PUBLIC_SERVER_URL)
SERVER_INTERNAL_URL=http://localhost:3000
# Must match backend INTERNAL_AUTH_SYNC_SECRET
INTERNAL_AUTH_SYNC_SECRET=your-super-secret-internal-auth-sync-key-min-32

# Cloudflare Workers (local preview via wrangler): copy .dev.vars.example to .dev.vars
# NEXTJS_ENV=development
#
# Subpath in production only: build:cloudflare sets NEXT_BASE_PATH=/ai-mock-interview automatically.
# Local dev (bun run dev) serves at http://localhost:3001/ with no basePath.
