# frontend (Next.js) - copy to frontend/.env.local for local development.
#
# NEXT_PUBLIC_SERVER_URL = public origin of the Express API (no trailing slash).
# Local: http://localhost:3000
# Labs / production: Railway public URL (set at deploy), e.g.
#   https://YOUR-AMI-API.up.railway.app
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_BORDERLESS_SIGNUP_URL=https://platform.borderlesscoding.com/sign-up

# better-auth (server-only)
# Must include Next basePath (/ai-mock-interview) so session cookies + /api/auth resolve correctly.
# Local:           http://localhost:3001/ai-mock-interview
# Labs workers.dev: https://labs-gateway.yuri-491.workers.dev/ai-mock-interview
# Labs custom DNS:  https://labs.borderlesscoding.com/ai-mock-interview
BETTER_AUTH_SECRET=your-super-secret-better-auth-key-min-32-chars
BETTER_AUTH_URL=http://localhost:3001/ai-mock-interview
BORDERLESS_API_BASE=https://api.borderlesscoding.com
