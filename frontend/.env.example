# frontend (Next.js) - copy to frontend/.env.local for local development.
#
# NEXT_PUBLIC_SERVER_URL = public origin of the Express API (no trailing slash).
# Local: http://localhost:3000
# Labs / production: Railway public URL (set at deploy), e.g.
#   https://YOUR-AMI-API.up.railway.app
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_BORDERLESS_SIGNUP_URL=https://platform.borderlesscoding.com/sign-up

# better-auth (server-only)
# Full better-auth mount URL = Next basePath + /api/auth (not the app root alone).
# Local:           http://localhost:3001/ai-mock-interview/api/auth
# Labs workers.dev: https://labs-gateway.yuri-491.workers.dev/ai-mock-interview/api/auth
# Labs custom DNS:  https://labs.borderlesscoding.com/ai-mock-interview/api/auth
# Production (no Next basePath): e.g. https://hone-navy.vercel.app/api/auth
BETTER_AUTH_SECRET=your-super-secret-better-auth-key-min-32-chars
BETTER_AUTH_URL=http://localhost:3001/ai-mock-interview/api/auth
BORDERLESS_API_BASE=https://api.borderlesscoding.com

# Express base for server-to-server opaque-token registration (same host as NEXT_PUBLIC_SERVER_URL)
SERVER_INTERNAL_URL=http://localhost:3000
# Must match backend INTERNAL_AUTH_SYNC_SECRET
INTERNAL_AUTH_SYNC_SECRET=your-super-secret-internal-auth-sync-key-min-32
