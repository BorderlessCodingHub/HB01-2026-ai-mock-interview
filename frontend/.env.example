# frontend (Next.js) - copy to frontend/.env.local for local development.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_BORDERLESS_SIGNUP_URL=https://platform.borderlesscoding.com/sign-up

# PostHog (product analytics). Leave unset to disable tracking entirely.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# better-auth (server-only)
BETTER_AUTH_SECRET=your-super-secret-better-auth-key-min-32-chars
# Production: set to the public frontend URL (e.g. https://labs.borderlesscoding.com/ai-mock-interview)
BETTER_AUTH_URL=http://localhost:3001
BORDERLESS_API_BASE=https://api.borderlesscoding.com

# Signs Hone access tokens after Borderless sign-in. Must match backend HONE_JWT_SECRET.
HONE_JWT_SECRET=your-super-secret-hone-jwt-key-min-32-characters
