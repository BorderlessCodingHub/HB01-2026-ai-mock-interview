model User {
  id              Int              @id @default(autoincrement())
  externalId      String?          @unique @map("external_id")
  name            String
  email           String           @unique
  password        String?
  interviewLocale InterviewLocale? @map("interview_locale")
  hasCompletedTutorial Boolean     @default(false) @map("has_completed_tutorial")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  resumes           Resume[]
  interviewSessions InterviewSession[]
  reviewItems        ReviewItem[]
  reviewSessions     ReviewSession[]
  interviewFeedbacks InterviewFeedback[]
  weakAnswers        WeakAnswer[]
  topicCoverages     TopicCoverage[]
  tokenUsage         UserTokenUsage[]
  sessionQuotaEvents SessionQuotaEvent[]

  @@map("users")
}

enum SessionQuotaKind {
  practice
  study
}

model SessionQuotaEvent {
  id        String           @id @default(uuid())
  userId    Int              @map("user_id")
  kind      SessionQuotaKind
  createdAt DateTime         @default(now()) @map("created_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
  @@map("session_quota_events")
}

model UserTokenUsage {
  userId           Int
  periodKey        String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, periodKey])
  @@map("user_token_usage")
}
